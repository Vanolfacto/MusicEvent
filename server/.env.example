PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://music_event_user:demo_password_change_me@localhost:5433/music_event_db
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_demo
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_demo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=10000
ML_SERVICE_RETRY_COUNT=2

# Produkcija (Render Web Service -> Environment):
# PORT ne treba postavljati ručno — Render ga sam dodeljuje i ubacuje kao env var.
# NODE_ENV=production
# DATABASE_URL=<connection string sa Render Postgres / Neon / Supabase>
# CORS_ORIGIN=https://<vas-projekat>.vercel.app
# ML_SERVICE_URL=https://<ml-servis>.onrender.com
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET — generisati nove, jake, nasumične vrednosti (ne koristiti demo iz ovog fajla)
