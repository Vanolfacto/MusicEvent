# ===========================================
# Music Event AI - Root Environment Example
# Copy to .env and adjust values as needed
# ===========================================

# PostgreSQL
POSTGRES_USER=music_event_user
POSTGRES_PASSWORD=demo_password_change_me
POSTGRES_DB=music_event_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://music_event_user:demo_password_change_me@localhost:5433/music_event_db

# Backend (Node.js)
SERVER_PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://music_event_user:demo_password_change_me@localhost:5433/music_event_db
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_demo
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_demo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=10000
ML_SERVICE_RETRY_COUNT=2

# Frontend (Vite)
VITE_API_URL=http://localhost:3001/api

# ML Service (Python)
ML_SERVICE_PORT=8000
ML_MODEL_VERSION=1.0.0
ML_MODEL_PATH=./models/best_model.joblib
RANDOM_SEED=42
